DATABASE_URL=postgresql://boutique:boutique@localhost:5434/boutique?schema=public
REDIS_URL=redis://localhost:6380
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me

# Frontend autorisé (CORS) et endpoint de revalidation
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
API_SERVICE_KEY=change-me

# 32 caractères minimum
JWT_SECRET=change-me-at-least-32-characters-long

# E-mails (Mailpit en dev : http://localhost:8026)
SMTP_URL=smtp://localhost:1026
MAIL_FROM="Leppi <bonjour@leppi.local>"

# Stockage des images : local (défaut) ou s3
STORAGE_DRIVER=local
PUBLIC_API_URL=http://localhost:4000
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY= S3_PUBLIC_URL=

# Paiements : secret HMAC des webhooks, identifiants opérateurs
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# ORANGE_MONEY_CLIENT_ID= ORANGE_MONEY_CLIENT_SECRET= MTN_MOMO_SUBSCRIPTION_KEY=

# Déclenchement des tâches planifiées par cron externe
JOBS_SECRET=change-me
